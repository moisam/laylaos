diff -rub ./musl-1.2.4/src/legacy/utmpx.c ./musl-1.2.4/src/legacy/utmpx.c
--- ./musl-1.2.4/src/legacy/utmpx.c	2023-05-02 16:45:28.000000000 +0100
+++ ./musl-1.2.4/src/legacy/utmpx.c	2026-01-22 23:55:46.237540833 +0000
@@ -3,6 +3,325 @@
 #include <stddef.h>
 #include <errno.h>
 
+#ifdef __laylaos__
+
+#include <utmp.h>               // _PATH_UTMP
+#include <stdlib.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <string.h>
+#include <fcntl.h>
+#include <signal.h>
+#include "lock.h"
+
+static struct utmpx *buf;       // buf to hold current entry
+static volatile int lock[1];    // lock to sync access to file
+static int fd = -1;             // utmpx file descriptor
+static int fdwr;                // non-zero i fd is open read/write
+
+static const char *default_path = _PATH_UTMP;
+static char *cur_path = NULL;
+
+
+void endutxent(void)
+{
+    LOCK(lock);
+
+    if(fd >= 0) {
+        close(fd);
+        fd = -1;
+        fdwr = 0;
+    }
+
+    UNLOCK(lock);
+}
+
+static void SIGALRM_handler(int signum)
+{
+    // do nothing
+}
+
+static inline int __try_open_utmpx(void)
+{
+    if(fd < 0) {
+        fdwr = 0;
+        if(!cur_path) cur_path = (char *)default_path;
+        if((fd = open(cur_path, O_RDONLY | O_CLOEXEC)) < 0) return 0;
+    }
+
+    return 1;
+}
+
+static inline int __try_lock_utmpx(int whichfd, int locktype)
+{
+    int saved_alarm, saved_errno, res;
+    struct sigaction oldsa;
+    struct sigaction newsa = { .sa_handler = SIGALRM_handler, .sa_flags = 0 };
+    struct flock lock = { .l_type = locktype, .l_whence = SEEK_SET };
+
+    // cancel and save any existing alarm
+    saved_alarm = alarm(0);
+
+    // set new signal handler and set alarm
+    sigemptyset(&newsa.sa_mask);
+    sigaction(SIGALRM, &newsa, &oldsa);
+    alarm(10);
+
+    // try lock
+    res = fcntl(whichfd, F_SETLKW, &lock);
+    saved_errno = errno;
+
+    // reset alarm and signal handler
+    alarm(0);
+    sigaction(SIGALRM, &oldsa, NULL);
+    if(saved_alarm) alarm(saved_alarm);
+
+    __set_errno(saved_errno);
+
+    return res;
+}
+
+static inline void __unlock_utmpx(int whichfd)
+{
+    struct flock lock = { .l_type = F_UNLCK };
+
+    fcntl(whichfd, F_SETLKW, &lock);
+}
+
+void setutxent(void)
+{
+    LOCK(lock);
+
+    if(!__try_open_utmpx()) return;
+    lseek(fd, 0, SEEK_SET);
+
+    UNLOCK(lock);
+}
+
+struct utmpx *getutxent(void)
+{
+    ssize_t n;
+
+    LOCK(lock);
+
+    if(!buf) {
+        if(!(buf = malloc(sizeof(struct utmpx)))) { UNLOCK(lock); return NULL; }
+    }
+
+    if(fd < 0 && !__try_open_utmpx()) { UNLOCK(lock); return NULL; }
+
+    if(__try_lock_utmpx(fd, F_RDLCK) < 0) { UNLOCK(lock); return NULL; }
+    n = read(fd, buf, sizeof(struct utmpx));
+    __unlock_utmpx(fd);
+
+    UNLOCK(lock);
+
+    return (n == sizeof(struct utmpx)) ? buf : NULL;
+}
+
+static inline int __utmpx_matches(const struct utmpx *ut)
+{
+    if(ut->ut_type >= RUN_LVL && ut->ut_type <= OLD_TIME) {
+        // for types RUN_LVL, BOOT_TIME, NEW_TIME and OLD_TIME, we only need
+        // to compare the ut_type file
+        return (ut->ut_type == buf->ut_type);
+    } else if((ut->ut_type >= INIT_PROCESS && ut->ut_type <= DEAD_PROCESS) &&
+              (buf->ut_type >= INIT_PROCESS && buf->ut_type <= DEAD_PROCESS)) {
+        // for types INIT_PROCESS, LOGIN_PROCESS, USER_PROCESS and DEAD_PROCESS,
+        // we need to compare the ut_id field
+        if(ut->ut_id[0] && buf->ut_id[0])
+            return !strncmp(ut->ut_id, buf->ut_id, sizeof(ut->ut_id));
+        else
+            return !strncmp(ut->ut_line, buf->ut_line, sizeof(ut->ut_line));
+    }
+
+    return 0;
+}
+
+struct utmpx *getutxid(const struct utmpx *ut)
+{
+    ssize_t n;
+
+    LOCK(lock);
+
+    if(!buf) {
+        if(!(buf = malloc(sizeof(struct utmpx)))) { UNLOCK(lock); return NULL; }
+    }
+
+    if(fd < 0 && !__try_open_utmpx()) { UNLOCK(lock); return NULL; }
+    if(__try_lock_utmpx(fd, F_RDLCK) < 0) { UNLOCK(lock); return NULL; }
+
+    while(1) {
+        n = read(fd, buf, sizeof(struct utmpx));
+        if(n < 0 || n != sizeof(struct utmpx)) break;
+
+        if(__utmpx_matches(ut)) {
+            __unlock_utmpx(fd);
+            UNLOCK(lock);
+            return buf;
+        }
+    }
+
+    __unlock_utmpx(fd);
+    UNLOCK(lock);
+
+    return NULL;
+}
+
+struct utmpx *getutxline(const struct utmpx *ut)
+{
+    ssize_t n;
+
+    LOCK(lock);
+
+    if(!buf) {
+        if(!(buf = malloc(sizeof(struct utmpx)))) { UNLOCK(lock); return NULL; }
+    }
+
+    if(fd < 0 && !__try_open_utmpx()) { UNLOCK(lock); return NULL; }
+    if(__try_lock_utmpx(fd, F_RDLCK) < 0) { UNLOCK(lock); return NULL; }
+
+    while(1) {
+        n = read(fd, buf, sizeof(struct utmpx));
+        if(n < 0 || n != sizeof(struct utmpx)) break;
+
+        // stop if we find user or login entry
+        if(buf->ut_type == USER_PROCESS || buf->ut_type == LOGIN_PROCESS) {
+            if(!strncmp(ut->ut_line, buf->ut_line, sizeof(buf->ut_line))) {
+                __unlock_utmpx(fd);
+                UNLOCK(lock);
+                return buf;
+            }
+        }
+    }
+
+    __unlock_utmpx(fd);
+    UNLOCK(lock);
+
+    return NULL;
+}
+
+struct utmpx *pututxline(const struct utmpx *ut)
+{
+    ssize_t n;
+    int found = 0;
+    off_t off, saved_off;
+
+    LOCK(lock);
+
+    if(!buf) {
+        if(!(buf = malloc(sizeof(struct utmpx)))) { UNLOCK(lock); return NULL; }
+    }
+
+    if(fd < 0 && !__try_open_utmpx()) { UNLOCK(lock); return NULL; }
+
+    // if the file is open for reading, make it writeable
+    if(!fdwr) {
+        int fd2;
+        if(!cur_path) cur_path = (char *)default_path;
+        if((fd2 = open(cur_path, O_RDWR | O_CLOEXEC)) < 0) { UNLOCK(lock); return NULL; }
+        if(dup2(fd2, fd) < 0) { UNLOCK(lock); return NULL; }
+        fdwr = 1;
+    }
+
+    if(__try_lock_utmpx(fd, F_WRLCK) < 0) { UNLOCK(lock); return NULL; }
+
+    saved_off = lseek(fd, 0, SEEK_CUR);
+
+    // try to find the entry in the file
+    while(1) {
+        n = read(fd, buf, sizeof(struct utmpx));
+        if(n < 0 || n != sizeof(struct utmpx)) break;
+
+        if(__utmpx_matches(ut)) { found = 1; break; }
+    }
+
+    if(found) {
+        // overwrite the found entry
+        off = lseek(fd, 0, SEEK_CUR);
+        off -= sizeof(struct utmpx);
+    } else {
+        // add to end of file, but round down to ensure we overwrite any
+        // partially written entry
+        off = lseek(fd, 0, SEEK_END);
+        off = (off / sizeof(struct utmpx) * sizeof(struct utmpx));
+    }
+
+    // write the new entry
+    if(lseek(fd, off, SEEK_SET) < 0 ||
+       (n = write(fd, ut, sizeof(struct utmpx))) < 0) {
+        lseek(fd, saved_off, SEEK_SET);
+        __unlock_utmpx(fd);
+        UNLOCK(lock);
+    	return NULL;
+    }
+
+    // ensure it is not a partial write and truncate the file if needed
+    if(n != sizeof(struct utmpx)) {
+        if(!found) ftruncate(fd, off);
+        __unlock_utmpx(fd);
+        UNLOCK(lock);
+    	return NULL;
+    }
+
+    __unlock_utmpx(fd);
+    UNLOCK(lock);
+
+	return (struct utmpx *)ut;
+}
+
+void updwtmpx(const char *f, const struct utmpx *u)
+{
+    int fd2;
+    off_t off;
+
+    if((fd2 = open(f, O_WRONLY | O_CLOEXEC)) < 0) return;
+    if(__try_lock_utmpx(fd2, F_WRLCK) < 0) { close(fd2); return; }
+
+    // store the original file size in case of error
+    off = lseek(fd2, 0, SEEK_END);
+
+    if(off % sizeof(struct utmpx)) {
+        off -= (off % sizeof(struct utmpx));
+        ftruncate(fd2, off);
+
+        if(lseek(fd2, 0, SEEK_END) < 0) {
+            __unlock_utmpx(fd2);
+            close(fd2);
+            return;
+        }
+    }
+
+    // write the entry
+    if(write(fd2, u, sizeof(struct utmpx)) != sizeof(struct utmpx)) {
+        // error writing or a partial write, restore file size to original
+        ftruncate(fd2, off);
+    }
+
+    __unlock_utmpx(fd2);
+    close(fd2);
+}
+
+static int __utmpxname(const char *f)
+{
+    char *copy = strdup(f);
+
+    // close current file
+    endutxent();
+
+    LOCK(lock);
+
+    if(!copy) { UNLOCK(lock); __set_errno(ENOMEM); return -1; }
+    if(cur_path && cur_path != default_path) free(cur_path);
+    cur_path = copy;
+
+    UNLOCK(lock);
+
+    return 0;
+}
+
+#else       /* !__laylaos__ */
+
 void endutxent(void)
 {
 }
@@ -41,6 +360,8 @@
 	return -1;
 }
 
+#endif      /* !__laylaos__ */
+
 weak_alias(endutxent, endutent);
 weak_alias(setutxent, setutent);
 weak_alias(getutxent, getutent);
