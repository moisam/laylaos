diff -rub ./musl-1.2.4/src/string/wcscmp.c ./musl-1.2.4/src/string/wcscmp.c
--- ./musl-1.2.4/src/string/wcscmp.c	2023-05-02 16:45:28.000000000 +0100
+++ ./musl-1.2.4/src/string/wcscmp.c	2026-07-04 07:42:06.324150743 +0100
@@ -1,7 +1,41 @@
 #include <wchar.h>
 
+#ifdef __laylaos__
+
+#include <emmintrin.h>
+
+int wcscmp(const wchar_t *l, const wchar_t *r)
+{
+    __m128i zero_vec = _mm_setzero_si128();
+
+    while (1) {
+        __m128i vec_l = _mm_loadu_si128((const __m128i *)l);
+        __m128i vec_r = _mm_loadu_si128((const __m128i *)r);
+
+        __m128i cmp_diff = _mm_cmpeq_epi32(vec_l, vec_r);
+        int diff_mask = ~_mm_movemask_epi8(cmp_diff) & 0xFFFF;
+
+        __m128i cmp_zero = _mm_cmpeq_epi32(vec_l, zero_vec);
+        int zero_mask = _mm_movemask_epi8(cmp_zero) & 0xFFFF;
+
+        if (diff_mask != 0 || zero_mask != 0) {
+            break;
+        }
+
+        l += 4;
+        r += 4;
+    }
+
+    for (; *l == *r && *l; l++, r++);
+    return *l < *r ? -1 : (*l > *r);
+}
+
+#else       // __laylaos__
+
 int wcscmp(const wchar_t *l, const wchar_t *r)
 {
 	for (; *l==*r && *l && *r; l++, r++);
 	return *l < *r ? -1 : *l > *r;
 }
+
+#endif      // __laylaos__
diff -rub ./musl-1.2.4/src/string/wcscpy.c ./musl-1.2.4/src/string/wcscpy.c
--- ./musl-1.2.4/src/string/wcscpy.c	2023-05-02 16:45:28.000000000 +0100
+++ ./musl-1.2.4/src/string/wcscpy.c	2026-07-04 07:43:38.067108815 +0100
@@ -1,8 +1,40 @@
 #include <wchar.h>
 
+#ifdef __laylaos__
+
+#include <emmintrin.h>
+
+wchar_t *wcscpy(wchar_t *restrict d, const wchar_t *restrict s)
+{
+    wchar_t *ret = d;
+    __m128i zero_vec = _mm_setzero_si128();
+
+    while (1) {
+        __m128i chunk = _mm_loadu_si128((const __m128i *)s);
+        
+        __m128i cmp_zero = _mm_cmpeq_epi32(chunk, zero_vec);
+        int zero_mask = _mm_movemask_epi8(cmp_zero) & 0xFFFF;
+
+        if (zero_mask != 0) {
+            break; // A null terminator exists in this block
+        }
+
+        _mm_storeu_si128((__m128i *)d, chunk);
+        s += 4;
+        d += 4;
+    }
+
+    while ((*d++ = *s++));
+    return ret;
+}
+
+#else       // __laylaos__
+
 wchar_t *wcscpy(wchar_t *restrict d, const wchar_t *restrict s)
 {
 	wchar_t *a = d;
 	while ((*d++ = *s++));
 	return a;
 }
+
+#endif      // __laylaos__
diff -rub ./musl-1.2.4/src/string/wcslen.c ./musl-1.2.4/src/string/wcslen.c
--- ./musl-1.2.4/src/string/wcslen.c	2023-05-02 16:45:28.000000000 +0100
+++ ./musl-1.2.4/src/string/wcslen.c	2026-07-04 07:37:15.899810604 +0100
@@ -1,8 +1,37 @@
 #include <wchar.h>
 
+#ifdef __laylaos__
+
+#include <emmintrin.h>
+
+size_t wcslen(const wchar_t *s)
+{
+    const wchar_t *start = s;
+    __m128i zero_vec = _mm_setzero_si128();
+
+    while (1) {
+        __m128i data_vec = _mm_loadu_si128((const __m128i *)s);
+        __m128i cmp = _mm_cmpeq_epi32(data_vec, zero_vec);
+
+        int mask = _mm_movemask_epi8(cmp);
+        if (mask != 0) {
+            int byte_index = __builtin_ctz(mask);
+            s += (byte_index / 4);
+            break;
+        }
+        s += 4;
+    }
+
+    return s - start;
+}
+
+#else       // __laylaos__
+
 size_t wcslen(const wchar_t *s)
 {
 	const wchar_t *a;
 	for (a=s; *s; s++);
 	return s-a;
 }
+
+#endif      // __laylaos__
