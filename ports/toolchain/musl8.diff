@@ -1,8 +1,33 @@
 #include <wchar.h>
 
+#ifdef __laylaos__
+
+#include <emmintrin.h>
+
+wchar_t *wmemcpy(wchar_t *restrict d, const wchar_t *restrict s, size_t n)
+{
+    wchar_t *a = d;
+
+    while (n >= 4) {
+        __m128i chunk = _mm_loadu_si128((const __m128i *)s);
+        _mm_storeu_si128((__m128i *)d, chunk);
+        s += 4;
+        d += 4;
+        n -= 4;
+    }
+
+    while (n--) *d++ = *s++;
+
+    return a;
+}
+
+#else       // __laylaos__
+
 wchar_t *wmemcpy(wchar_t *restrict d, const wchar_t *restrict s, size_t n)
 {
 	wchar_t *a = d;
 	while (n--) *d++ = *s++;
 	return a;
 }
+
+#endif      // __laylaos__
