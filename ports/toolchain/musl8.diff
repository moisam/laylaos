+
+wchar_t *wcsncpy(wchar_t *restrict d, const wchar_t *restrict s, size_t n)
+{
+    wchar_t *ret = d;
+    __m128i zero_vec = _mm_setzero_si128();
+
+    while (n >= 4) {
