+
+    while (n >= 4) {
+        __m128i vec_l = _mm_loadu_si128((const __m128i *)l);
+        __m128i vec_r = _mm_loadu_si128((const __m128i *)r);
+
+        int diff_mask = ~_mm_movemask_epi8(_mm_cmpeq_epi32(vec_l, vec_r)) & 0xFFFF;
+        int zero_mask = _mm_movemask_epi8(_mm_cmpeq_epi32(vec_l, zero_vec)) & 0xFFFF;
+
+        if (diff_mask != 0 || zero_mask != 0) {
+            break;
+        }
+
+        l += 4;
+        r += 4;
+        n -= 4;
+    }
+
+    for (; n && *l == *r && *l; n--, l++, r++);
+    return n ? (*l < *r ? -1 : (*l > *r)) : 0;
+}
+
+#else       // __laylaos__
+
 int wcsncmp(const wchar_t *l, const wchar_t *r, size_t n)
 {
 	for (; n && *l==*r && *l && *r; n--, l++, r++);
