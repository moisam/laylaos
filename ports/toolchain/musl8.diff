diff -rub ./musl-1.2.4/src/string/wmemchr.c ./musl-1.2.4/src/string/wmemchr.c
--- ./musl-1.2.4/src/string/wmemchr.c	2023-05-02 16:45:28.000000000 +0100
+++ ./musl-1.2.4/src/string/wmemchr.c	2026-07-04 07:36:09.300753446 +0100
@@ -1,7 +1,44 @@
 #include <wchar.h>
 
+#ifdef __laylaos__
+
+#include <emmintrin.h>
+
+wchar_t *wmemchr(const wchar_t *s, wchar_t c, size_t n)
+{
+    if (n >= 4) {
+        __m128i target_vec = _mm_set1_epi32(c);
+
+        while (n >= 4) {
+            __m128i data_vec = _mm_loadu_si128((const __m128i *)s);
+            __m128i cmp = _mm_cmpeq_epi32(data_vec, target_vec);
+            
+            int mask = _mm_movemask_epi8(cmp);
+            if (mask != 0) {
+                int byte_index = __builtin_ctz(mask);
+                return (wchar_t *)s + (byte_index / 4);
+            }
+
+            s += 4;
+            n -= 4;
+        }
+    }
+
+    for (; n; n--, s++) {
+        if (*s == c) {
+            return (wchar_t *)s;
+        }
+    }
+
+    return NULL;
+}
+
+#else       // __laylaos__
+
 wchar_t *wmemchr(const wchar_t *s, wchar_t c, size_t n)
 {
 	for (; n && *s != c; n--, s++);
 	return n ? (wchar_t *)s : 0;
 }
+
+#endif      // __laylaos__
diff -rub ./musl-1.2.4/src/string/wmemcmp.c ./musl-1.2.4/src/string/wmemcmp.c
--- ./musl-1.2.4/src/string/wmemcmp.c	2023-05-02 16:45:28.000000000 +0100
+++ ./musl-1.2.4/src/string/wmemcmp.c	2026-07-04 07:34:14.334503643 +0100
@@ -1,7 +1,46 @@
 #include <wchar.h>
 
+#ifdef __laylaos__
+
+#include <emmintrin.h>
+
+int wmemcmp(const wchar_t *l, const wchar_t *r, size_t n)
+{
+    while (n >= 4) {
+        __m128i vec_l = _mm_loadu_si128((const __m128i *)l);
+        __m128i vec_r = _mm_loadu_si128((const __m128i *)r);
+
+        // Compare elements for equality (produces 0xFFFFFFFF if matching, 0x0 if not)
+        __m128i cmp = _mm_cmpeq_epi32(vec_l, vec_r);
+
+        int mask = _mm_movemask_epi8(cmp);
+
+        // If the mask is not 0xFFFF, it means at least one of the 4 elements differs
+        if (mask != 0xFFFF) {
+            break; 
+        }
+
+        l += 4;
+        r += 4;
+        n -= 4;
+    }
+
+    // Scalar evaluation pass to process remaining elements or isolate the mismatching index
+    for (; n; n--, l++, r++) {
+        if (*l != *r) {
+            return *l < *r ? -1 : 1;
+        }
+    }
+
+    return 0;
+}
+
+#else       // __laylaos__
+
 int wmemcmp(const wchar_t *l, const wchar_t *r, size_t n)
 {
 	for (; n && *l==*r; n--, l++, r++);
 	return n ? (*l < *r ? -1 : *l > *r) : 0;
 }
+
+#endif      // __laylaos__
