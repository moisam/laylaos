@@ -1,8 +1,35 @@
 #include <wchar.h>
 
+#ifdef __laylaos__
+
+#include <emmintrin.h>
+
 wchar_t *wmemset(wchar_t *d, wchar_t c, size_t n)
 {
 	wchar_t *ret = d;
+
+    if (n >= 4) {
+        __m128i val_vec = _mm_set1_epi32(c);
+
+        while (n >= 4) {
+            _mm_storeu_si128((__m128i *)d, val_vec);
