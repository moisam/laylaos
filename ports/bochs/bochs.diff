     if (S_ISBLK(stat_buf.st_mode)) { // Is this a special device file (e.g. /dev/sde) ?
       ioctl(fd, BLKGETSIZE64, fsize); // yes it's!
     }
@@ -553,7 +558,7 @@
 {
 #ifdef WIN32
   return (bool)CopyFile(src, dst, FALSE);
