     { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking for mvaddch in -lpdcurses" >&5
@@ -27118,7 +27118,7 @@
 printf "%s\n" "$ac_cv_lib_pdcurses_mvaddch" >&6; }
